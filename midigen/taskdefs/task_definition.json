[
  {
    "name": "${container_name}",
    "image": "${container_image}",
    "essential": true,
    "portMappings": [
      {
        "containerPort": "${container_port}",
        "protocol": "tcp"
      }
    ],
    "environment": [
      {
        "name": "ENV",
        "value": "${environment}"
      },
      {
        "name": "CONFIG_DIR",
        "value": "/app"
      },
      {
        "name": "DB_HOST",
        "value": "${db_host}"
      },
      {
        "name": "DB_PORT",
        "value": "${db_port}"
      },
      {
        "name": "DB_NAME",
        "value": "${db_name}"
      },
      {
        "name": "DB_USER",
        "value": "${db_username}"
      },
      {
        "name": "S3_BUCKET",
        "value": "${s3_bucket}"
      },
      {
        "name": "AWS_REGION",
        "value": "${aws_region}"
      },
      {
        "name": "S3_ENDPOINT_URL",
        "value": ""
      }
    ],
    "secrets": [
      {
        "name": "ANTHROPIC_API_KEY",
        "valueFrom": "${anthropic_secret_arn}"
      },
      {
        "name": "DB_PASSWORD",
        "valueFrom": "${db_password_secret_arn}:password::"
      }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "${log_group}",
        "awslogs-region": "${aws_region}",
        "awslogs-stream-prefix": "api"
      }
    }
  }
]
